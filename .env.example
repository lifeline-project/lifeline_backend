# LifeLine Backend Environment Configuration
PORT=8080

# Database Configuration (PostgreSQL / Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lifeline_db?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_CONN_TIMEOUT_SECS=10
DB_AUTO_MIGRATE=true

# Authentication & Security
JWT_SECRET=your-secret-key-change-in-production-min-32-chars

# Logger Settings
LOGGER_SERVICE=lifeline-backend
LOGGER_ENV=dev
LOGGER_LEVEL=info
LOGGER_DEV=true

# Optional: Cloudflare R2 Storage for Prescription Images
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
